# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key encoded as 64 hexadecimal characters. Generate with:
# openssl rand -hex 32
MT5_ENCRYPTION_KEY=

# Mock mode is simulation only; it must never connect to a broker or place trades.
MOCK_MODE=true

# Optional application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
